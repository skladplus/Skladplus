{
  "name": "skladplus",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --if-present --parallel dev",
    "build": "pnpm -r --if-present build",
    "start": "pnpm -r --if-present start",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm -r --if-present test:e2e",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:generate": "pnpm -r --if-present db:generate",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "db:deploy": "pnpm -r --if-present db:deploy",
    "db:status": "pnpm -r --if-present db:status",
    "context": "bash scripts/context.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp",
      "@tailwindcss/oxide",
      "unrs-resolver"
    ]
  }
}
