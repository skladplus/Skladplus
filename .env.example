# Образец. Реальные значения живут вне репозитория: ~/.skladplus/env + direnv.
# Файл .env в git не попадёт — .gitignore устроен по принципу deny-by-default,
# а на сервере работает push protection.

# Пул соединений. Обычные запросы приложения.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/skladplus"

# Прямое подключение. Миграции ходят только через него: pooled их не переживёт.
# Локально совпадает с DATABASE_URL, на Neon это разные адреса.
# На Vercel эта же строка приходит от интеграции Neon под именем
# DATABASE_URL_UNPOOLED — prisma.config.ts принимает оба имени.
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5433/skladplus"

# Отдельная база под prisma migrate diff. Prisma её пересоздаёт при каждом
# запуске — указывать сюда рабочую базу нельзя.
SHADOW_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/skladplus_shadow"

# Ключ Neon для MCP. Ограничен ОДНИМ проектом Skladplus: с ним агент не видит
# базы других проектов аккаунта — проверено отказом «not allowed to perform
# actions outside the project this key is scoped to».
# Настоящее значение живёт только в ~/.skladplus/env.
NEON_API_KEY="napi_..."
