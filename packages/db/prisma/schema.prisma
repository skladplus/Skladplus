// Доменных таблиц здесь пока нет сознательно: бизнес-правила не закрыты,
// и написанная сейчас схема была бы переписана (docs/09-findings-backlog.md).
// Смысл файла на этапе 0 — прогнать конвейер миграций до появления схемы.
//
// Когда таблицы появятся: деньги — BigInt, время — DateTime @db.Timestamptz(3),
// у каждой таблицы с данными клиента обязателен accountId и индекс по нему.

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

// В Prisma 7 строки подключения в схеме не задаются — они в prisma.config.ts
// (для миграций) и в driver adapter (для рантайма). Здесь остаётся только диалект.
datasource db {
  provider = "postgresql"
}
