{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Read(./Skladplus находка/**)",
      "Read(//Users/*/.ssh/**)",
      "Read(//Users/*/.aws/**)",
      "Read(//Users/*/.config/gh/**)",
      "Read(//Users/*/Desktop/NovaPostBot/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(gh gist:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm dlx:*)",
      "Bash(npx:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/context.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
