{
  "includeCoAuthoredBy": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./secrets/**)",
      "Read(./Skladplus находка/**)",
      "Read(//Users/*/.ssh/**)",
      "Read(//Users/*/.aws/**)",
      "Read(//Users/*/.config/gh/**)",
      "Read(//Users/*/Desktop/NovaPostBot/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(gh gist:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(pnpm dlx:*)",
      "Bash(npx:*)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.preview)",
      "Read(./**/.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/.npmrc)",
      "Read(//Users/*/.skladplus/**)",
      "Read(//Users/*/.npmrc)",
      "Read(//Users/*/.vercel/**)",
      "Read(//Users/*/.docker/config.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Desktop/NovaPostBot/**)",
      "Read(~/.skladplus/**)",
      "Read(~/.npmrc)",
      "Read(~/.vercel/**)",
      "Read(~/.docker/config.json)",
      "Read(./**/.env.*)"
    ],
    "ask": [
      "Read(./**/node_modules/**)",
      "Read(./**/vendor/**)",
      "Read(./**/.pnpm-store/**)",
      "Read(./pnpm-lock.yaml)",
      "Read(./**/.next/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/.vercel/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/out/**)",
      "Read(./**/coverage/**)",
      "Read(./**/*.tsbuildinfo)",
      "Read(./packages/*/src/generated/**)",
      "Read(./**/playwright-report/**)",
      "Read(./**/test-results/**)",
      "Read(./**/blob-report/**)",
      "Read(./**/*.log)",
      "Read(./**/logs/**)",
      "Read(./**/*.png)",
      "Read(./**/*.jpg)",
      "Read(./**/*.jpeg)",
      "Read(./**/*.gif)",
      "Read(./**/*.webp)",
      "Read(./**/*.ico)",
      "Read(./**/*.pdf)",
      "Read(./**/*.mp4)",
      "Read(./**/*.mov)",
      "Read(./**/*.zip)",
      "Read(./**/*.woff)",
      "Read(./**/*.woff2)",
      "Read(./**/*.ttf)",
      "Read(./**/*.otf)",
      "Read(./.env.example)",
      "Read(./**/.env.example)",
      "Read(./**/.env.*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/context.sh\" 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "github@claude-plugins-official": true,
    "coderabbit@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "prisma@claude-plugins-official": true,
    "neon@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "semgrep@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "42crunch-api-security-testing@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true
  }
}
